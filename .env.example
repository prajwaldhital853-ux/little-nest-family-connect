# Copy to .env for local work. Nothing here is a secret; the real values for a deployed site
# go in the hosting dashboard, never in a file in this repo.

# Where the site sends its API calls. Leave empty in development: the Vite proxy forwards /api
# to the backend, and an empty value is also what makes the bundled content show if the API
# is not running. Set the backend's public origin, without a trailing slash, for a deployed build.
VITE_API_URL=

# Where `npm run dev` proxies /api to. Must match the running backend.
VITE_BACKEND_URL=http://127.0.0.1:8000

# Where `npm run dev` proxies /admin to: the panel in ../admin. Leave it alone unless that
# panel runs somewhere other than its own default port.
VITE_PANEL_URL=http://127.0.0.1:5173

# From the template this site was built from, which is being retired. Only `src/integrations/
# supabase/client.ts` reads them, and it is reached from the leftover /sign-in page, not from any
# of the doctor's pages. The panel in ../admin is what signs the doctor in.
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
