{
  "framework": "vite",
  "buildCommand": "npm run build && npm run build:panel",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://little-nest-family-connect.onrender.com/api/:path*"
    },
    {
      "source": "/api/:path*/",
      "destination": "https://little-nest-family-connect.onrender.com/api/:path*/"
    },
    {
      "source": "/media/:path*",
      "destination": "https://little-nest-family-connect.onrender.com/media/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
