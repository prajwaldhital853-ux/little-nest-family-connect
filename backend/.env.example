# Copy to .env and fill in. Never commit the real .env.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
# A phone on the same wifi reaches this machine by its network address, and every call from the
# panel carries that address. '*' is for a development machine only; a deployed host lists its own
# domain here through the hosting dashboard.
DJANGO_ALLOWED_HOSTS=*
DJANGO_TIME_ZONE=Asia/Kathmandu
DJANGO_LOG_LEVEL=INFO

# Only the addresses listed here can sign in to the panel with a password.
# Staff accounts get created for helpers but are signed in through this list.
ADMIN_LOGIN_EMAILS=drameshkandel@gmail.com
# The Django /admin/ site stays off; the React panel is the front door.
DJANGO_ADMIN_ENABLED=false

# postgresql (default) or sqlite, for running the tests without a database server
DB_ENGINE=postgresql
# A hosted database is usually handed over as one string rather than five parts. When it is set it
# wins over the POSTGRES_* values below, so leave it empty on a development machine.
DATABASE_URL=
POSTGRES_DB=kandel_cms
POSTGRES_USER=kandel
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# 15 minutes access, 7 days refresh. The refresh token is only ever read from its cookie.
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# optional separate signing key; defaults to DJANGO_SECRET_KEY
JWT_SIGNING_KEY=

API_PAGE_SIZE=20
# Per scope throttles. public_feed caps anonymous reads of the blog and media feeds; the
# rest guard the sign in flow and the public forms. Generous on purpose: a family sharing
# one mobile address should never notice the limit, a script walking the corpus will.
THROTTLE_PUBLIC_FEED=2000/hour
THROTTLE_LOGIN=10/min
THROTTLE_OTP=6/min
THROTTLE_RESET=6/min
THROTTLE_COLLECT=60/min
THROTTLE_APPOINTMENT=20/day

# Where the panel lives. It is mounted at /admin on the public site, so the origin is the site's
# and the path is the mount. Both are checked against the Origin header on cookie-backed auth
# calls, and together they build the reset link that goes out by mail.
PANEL_ORIGIN=http://localhost:8080
PANEL_PATH=/admin
# comma separated public site origins, e.g. http://localhost:8080,https://drameshkandel.example
CORS_ALLOWED_ORIGINS=http://localhost:8080
CORS_ALLOW_ALL_ORIGINS=false

# Lockout and one time codes. 3 bad passwords freeze one device and one IP for 5 minutes.
LOGIN_MAX_ATTEMPTS=3
LOGIN_LOCK_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_TTL_MINUTES=10
PASSWORD_RESET_MINUTES=30

# An appointment with the same IP, device and wording is accepted once in this window.
SUBMISSION_DEDUPE_HOURS=24

# Cookie names and where they live. Do not widen AUTH_COOKIE_PATH past /api/auth/.
REFRESH_COOKIE_NAME=kandel_rtk
DEVICE_COOKIE_NAME=kandel_did
OTP_COOKIE_NAME=kandel_otp
# leave empty for a host only cookie; set to .example.com for a shared domain
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax

# Turn on only behind a proxy that sets a trusted client address, otherwise IPs are spoofable.
USE_X_FORWARDED_FOR=false
# Behind a hosting proxy that forwards the address and the scheme the visitor used. Without both
# the app thinks every call is plain http on the container's own name and the cookies go astray.
USE_X_FORWARDED_HOST=false
# written as HEADER,value, e.g. HTTP_X_FORWARDED_PROTO,https
SECURE_PROXY_SSL_HEADER=
SECURE_SSL_REDIRECT=false

# OTP and reset mails. Without EMAIL_HOST the letters land in backend/outbox/ so the flow is testable.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Dr. Ramesh Kandel <replies@localhost>
EMAIL_FILE_PATH=outbox
