# Copy to .env and fill in. Leave VITE_API_URL empty in development.

# Where the panel sends /api calls. Empty means same origin and the Vite proxy forwards them,
# which is what the browser needs: the sign in cookies are set by the backend, so requests
# must travel through the proxy rather than straight to another host.
# For a deployed panel set the public API origin, e.g. https://api.example.com
VITE_API_URL=

# Where `npm run dev` proxies /api to. Must match the running backend.
VITE_BACKEND_URL=http://127.0.0.1:8000

# Used for the "View this page on the site" links in Page wording.
# Empty in development falls back to the site on http://localhost:8080.
VITE_SITE_URL=
